# Copy to .env (backend) and frontend/.env.local as appropriate. Never commit
# real values (CLAUDE.md rule). See docs/V1_IMPLEMENTATION_PLAN.md.

ENVIRONMENT=development

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres connection string (used by the backend to open per-request,
# JWT-scoped connections so RLS is enforced). With `supabase start` this is
# typically postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Redis / queue --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Email (Resend) ----------------------------------------------------------
# Empty = no-op provider (emails logged with provider 'noop', never sent).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=support@clickfieldai.com
# Provider selection: noop | resend | smtp. Empty = auto-detect (resend if
# RESEND_API_KEY set, smtp if SMTP_HOST set, otherwise noop). See docs/SMTP.md.
EMAIL_PROVIDER=
# SMTP (backend only - never NEXT_PUBLIC_). Empty SMTP_HOST = noop provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ClickfieldAI Support
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=2

# --- Rate limiting (spec 54) -------------------------------------------------
# memory = single API instance; redis = shared across instances
RATE_LIMIT_BACKEND=memory

# --- CORS: JSON list of allowed frontend origins (never "*") -----------------
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000
STORAGE_BUCKET=ticket-attachments

# --- Frontend (Next.js) - NEXT_PUBLIC_* are exposed to the browser ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
