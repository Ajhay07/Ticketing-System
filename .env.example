# Copy to .env (backend) and frontend/.env.local as appropriate. Never commit
# real values (CLAUDE.md rule). See docs/V1_IMPLEMENTATION_PLAN.md.

ENVIRONMENT=development

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres connection string (used by the backend to open per-request,
# JWT-scoped connections so RLS is enforced). With `supabase start` this is
# typically postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Redis / queue --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Email (Resend) - Phase 4 ---------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=support@clickfieldai.com

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:3000
STORAGE_BUCKET=ticket-attachments

# --- Frontend (Next.js) - NEXT_PUBLIC_* are exposed to the browser ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
